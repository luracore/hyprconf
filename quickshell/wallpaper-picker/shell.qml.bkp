import QtQuick
import Quickshell
import Quickshell.Io

PanelWindow {
  implicitWidth: 900
  implicitHeight: 600

  anchors {
    left: true
    right: true
    top: true
    bottom: true
  }

  Shortcut {
    sequence: "Esc"
    context: Qt.ApplicationShortcut
    onActivated: Qt.quit()
  }

  focusable: true

  color: "transparent"

  ListModel {
    id: wallpapersModel
  }

  Process {
    id: wallpaperProcess

    command: ["bash", "/home/luracore/hyprconf/quickshell/wallpaper-picker/wallpapers.sh"]

    stdout: StdioCollector {
      onStreamFinished: {
        const lines = text.trim().split("\n")

        for (const line of lines) {
          const parts = line.split("\t")

          if (parts.length !== 2)
          continue

          wallpapersModel.append({
            wallpaperPath: parts[0],
            thumbnailPath: "file://" + parts[1]
          })
        }
      }
    }

    Component.onCompleted: running = true
  }

  GridView {
    anchors.centerIn: parent

    width: 600
    height: 600

    cellWidth: 200
    cellHeight: 200

    model: wallpapersModel
    clip: true

    currentIndex: 0

    focus: true

    Keys.onPressed: (event) => {
      const columns = 3
      const rows = Math.ceil(count / columns)
      const row = Math.floor(currentIndex / columns)
      const column = currentIndex % columns

      if (event.key === Qt.Key_H) {
        currentIndex = row * columns + (column - 1 + columns) % columns
      } else if (event.key === Qt.Key_L) {
        currentIndex = row * columns + (column + 1) % columns
      } else if (event.key === Qt.Key_K) {
        currentIndex = ((row - 1 + rows) % rows) * columns + column
      } else if (event.key === Qt.Key_J) {
        currentIndex = ((row + 1) % rows) * columns + column
      } else {
        return
      }

      event.accepted = true
    }

    delegate: Rectangle {
      required property string thumbnailPath
      required property string wallpaperPath

      width: 190
      height: 190

      radius: 8
      color: "#303030"

      Image {
        anchors.fill: parent
        anchors.margins: 3

        source: thumbnailPath
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        cache: true
      }

      border.width: GridView.isCurrentItem ? 3 : 2
      border.color: GridView.isCurrentItem ? "#f0c674" : "#505050"
    }
  }
}
