#!/usr/bin/env bash
# RepoStore: pacotes dos repositórios oficiais, do AUR (yay) e do Flathub.
# Abas: Alt+1…3, ←/→ ou clique. Ctrl+S alterna Todos/Instalados, Ctrl+U as
# Atualizações (Enter atualiza tudo), Ctrl+H mostra os atalhos da tela.

set -uo pipefail

SELF=$(readlink -f "$0")
source "$(dirname "$SELF")/lib/common.sh"

STATE=${HYPRCONF_PKG_STATE:-}
PREVIEW_NORMAL='right,45%,border-left,wrap'
FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"

# Telas: "<fonte>:<modo>" (pacman:all, aur:installed, flatpak:updates...),
# "help" e "<fonte>:missing" (falta o yay ou o flatpak).
screen() { cat "$STATE/screen" 2>/dev/null || echo pacman:all; }
set_screen() { echo "$1" > "$STATE/screen"; }

# tela de onde a Ajuda foi aberta
origin() { cat "$STATE/prev" 2>/dev/null || echo pacman:all; }

has_yay() { command -v yay >/dev/null; }
has_flatpak() { command -v flatpak >/dev/null; }

available() {
    case $1 in
        aur) has_yay ;;
        flatpak) has_flatpak ;;
        *) return 0 ;;
    esac
}

# telas sem busca nem prévia
is_text() { [[ $1 == help || $1 == *:missing ]]; }

source_of() { case $1 in pacman:*|aur:*|flatpak:*) echo "${1%%:*}" ;; esac; }
mode_of() { case $1 in pacman:*|aur:*|flatpak:*) echo "${1#*:}" ;; esac; }

list_pacman() {
    LC_ALL=C pacman -Sl | awk -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '{
        mark = ($4 ~ /installed/) ? ok "✓" reset : " "
        printf "%-30s %s %s%-16s %s%s\n", $2, mark, dim, $3, $1, reset
    }'
}

# checkupdates usa uma cópia do banco de dados: não mexe no sistema
list_pacman_updates() {
    checkupdates 2>/dev/null > "$STATE/updates"
    format_updates "$STATE/updates"
}

format_updates() {
    awk -v dim="$C_DIM" -v ok="$C_OK" -v reset="$C_RESET" 'NF >= 4 {
        printf "%-30s %s%-16s%s → %s%s%s\n", $1, dim, $2, reset, ok, $4, reset
    }' "$1"
}

# A lista completa demora uns segundos: é baixada em segundo plano assim que o
# app abre e fica guardada durante a sessão.
fetch_aur() {
    has_yay || return 0
    local tmp; tmp=$(mktemp "$STATE/aur.XXXXXX")
    LC_ALL=C yay -Sl aur 2>/dev/null | awk '{ print $2 }' > "$tmp" && mv -f "$tmp" "$STATE/aur.list"
}

list_aur() {
    [[ -s $STATE/aur.list ]] || fetch_aur
    # FILENAME, e não NR == FNR: com o pacman -Qm vazio, NR == FNR valeria
    # também para a aur.list
    awk -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '
        FILENAME == ARGV[1] { installed[$1] = $2; next }
        ($1 in installed) { printf "%-30s %s✓%s %s%s%s\n", $1, ok, reset, dim, installed[$1], reset; next }
        { print }' <(pacman -Qm) "$STATE/aur.list"
}

list_aur_updates() {
    LC_ALL=C yay -Qua 2>/dev/null > "$STATE/updates.aur"
    format_updates "$STATE/updates.aur"
}

# Flatpak sempre com --user: não pede senha.

fetch_flatpak() {
    has_flatpak || return 0
    flatpak remote-add --user --if-not-exists flathub "$FLATHUB_URL" >/dev/null 2>&1
    local tmp; tmp=$(mktemp "$STATE/flatpak.XXXXXX")
    flatpak remote-ls --user flathub --app --columns=application,name,version 2>/dev/null > "$tmp" &&
        mv -f "$tmp" "$STATE/flatpak.list"
}

list_flatpak() {
    [[ -s $STATE/flatpak.list ]] || fetch_flatpak
    awk -F'\t' -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '
        FILENAME == ARGV[1] { installed[$1] = 1; next }
        { printf "%-42s %s %s%s  %s%s\n", $1, (($1 in installed) ? ok "✓" reset : " "), "", $2, dim $3, reset }
    ' <(flatpak list --user --app --columns=application 2>/dev/null) "$STATE/flatpak.list"
}

list_flatpak_installed() {
    flatpak list --user --app --columns=application,name,version 2>/dev/null |
        awk -F'\t' -v dim="$C_DIM" -v reset="$C_RESET" '{ printf "%-42s %s  %s%s%s\n", $1, $2, dim, $3, reset }'
}

list_flatpak_updates() {
    flatpak remote-ls --user --updates --app --columns=application,name,version 2>/dev/null |
        awk -F'\t' -v ok="$C_OK" -v reset="$C_RESET" '{ printf "%-42s %s  → %s%s%s\n", $1, $2, ok, $3, reset }'
}

missing_lines() {
    local b=$C_BOLD a=$C_ACCENT d=$C_DIM w=$C_WARN r=$C_RESET
    printf '\n'
    case $1 in
        flatpak)
            printf '  %sO flatpak não está instalado.%s\n\n' "$b" "$r"
            printf '  Apps do Flathub, em sandbox e só para o seu usuário (sem senha).\n'
            printf '  O RepoStore adiciona o Flathub sozinho.\n\n'
            printf '  Para instalar, num terminal:\n\n'
            printf '    %ssudo pacman -S flatpak%s\n\n' "$a" "$r"
            printf '  %sDepois, troque de aba e volte. Os apps aparecem no lançador depois\n' "$d"
            printf '  de sair e entrar de novo no Hyprland.%s\n' "$r" ;;
        aur)
            printf '  %sO yay não está instalado.%s\n\n' "$b" "$r"
            printf '  O AUR tem pacotes enviados pela comunidade, fora dos repositórios\n'
            printf '  oficiais. O RepoStore usa o yay para buscar, instalar e atualizar.\n\n'
            printf '  %sO yay também vem do AUR: o makepkg roda o PKGBUILD dele.%s\n' "$w" "$r"
            printf '  Para instalar, num terminal:\n\n'
            printf '    %ssudo pacman -S --needed git base-devel%s\n' "$a" "$r"
            printf '    %sgit clone https://aur.archlinux.org/yay-bin.git%s\n' "$a" "$r"
            printf '    %scd yay-bin && makepkg -si%s\n\n' "$a" "$r"
            printf '  %sDepois, troque de aba e volte.%s\n' "$d" "$r" ;;
    esac
}

list() {
    local scr out
    scr=$(screen)
    case $scr in
        *:missing) missing_lines "${scr%%:*}"; return ;;
        pacman:all) out=$(list_pacman) ;;
        pacman:installed) out=$(list_installed repo) ;;
        pacman:updates) out=$(list_pacman_updates) ;;
        aur:all) out=$(list_aur) ;;
        aur:installed) out=$(list_installed aur) ;;
        aur:updates) out=$(list_aur_updates) ;;
        flatpak:all) out=$(list_flatpak) ;;
        flatpak:installed) out=$(list_flatpak_installed) ;;
        flatpak:updates) out=$(list_flatpak_updates) ;;
        help) help_lines; return ;;
    esac
    # lista vazia: uma linha "— …" (ações e prévia ignoram o "—")
    if [[ -n $out ]]; then
        printf '%s\n' "$out"
    else
        printf '%s— %s%s\n' "$C_DIM" "$(empty_message "$scr")" "$C_RESET"
    fi
}

# o que vem da internet é guardado durante a sessão: a prévia roda a cada
# movimento do cursor
cached() {
    local file="$STATE/preview/$1"; shift
    if [[ ! -s $file ]]; then
        mkdir -p "$STATE/preview"
        "$@" 2>/dev/null > "$file.tmp" && mv -f "$file.tmp" "$file"
    fi
    cat "$file" 2>/dev/null
}

preview_package() {
    local item=$1 src=$2
    preview_installed "$item" && return
    if [[ $src == aur ]]; then
        printf '%sAUR: pacote enviado pela comunidade. O yay mostra o PKGBUILD para revisar antes de instalar.%s\n\n' "$C_WARN" "$C_RESET"
        cached "aur-$item" yay -Si --aur "$item" | paint
    else
        pacman -Si "$item" 2>/dev/null | paint
    fi
}

preview_update() {
    local item=$1 file=$2 old new
    read -r _ old _ new < <(grep -h -m1 "^$item " "$file" 2>/dev/null) &&
        printf '%s%s%s  %s → %s%s%s\n\n' "$C_BOLD" "$item" "$C_RESET" "$old" "$C_OK" "$new" "$C_RESET"
}

preview() {
    local item=$1 scr
    [[ $item == "—" ]] && return
    scr=$(screen)
    is_text "$scr" && return
    case $scr in
        pacman:all|pacman:installed) preview_package "$item" pacman ;;
        aur:all|aur:installed) preview_package "$item" aur ;;
        pacman:updates)
            preview_update "$item" "$STATE/updates"
            pacman -Si "$item" 2>/dev/null | paint ;;
        aur:updates)
            preview_update "$item" "$STATE/updates.aur"
            cached "aur-$item" yay -Si --aur "$item" | paint ;;
        flatpak:*)
            local details
            if details=$(flatpak info --user "$item" 2>/dev/null); then
                printf '%s✓ instalado%s\n\n' "$C_OK" "$C_RESET"
                printf '%s\n' "$details" | paint
            else
                cached "flatpak-$item" flatpak remote-info --user flathub "$item" | paint
            fi ;;
    esac
}

tabs() {
    printf '%s\n' pacman aur flatpak
}

tab_of() {
    source_of "$1"
}

tab_label() {
    case $1 in
        pacman) echo "Pacman" ;;
        aur) echo "AUR" ;;
        flatpak) echo "Flatpak" ;;
    esac
}

tabs_header() {
    local current out="" t
    current=$(tab_of "$1")
    while read -r t; do
        if [[ $t == "$current" ]]; then
            out+="${C_BOLD}${C_ACCENT}"$'\e[4m'"$(tab_label "$t")${C_RESET}   "
        else
            out+="${C_DIM}$(tab_label "$t")${C_RESET}   "
        fi
    done < <(tabs)
    printf '%s' "$out"
}

# tela de uma aba, mantendo o modo da tela atual (Instalados no Pacman leva a
# Instalados no AUR)
screen_for_tab() {
    local tab=$1 mode
    available "$tab" || { echo "$tab:missing"; return; }
    mode=$(mode_of "$2")
    [[ $mode == missing ]] && mode=all
    echo "$tab:${mode:-all}"
}

# $2: -1 ou 1, dando a volta
tab_step() {
    local list current i n
    mapfile -t list < <(tabs)
    n=${#list[@]}
    current=$(tab_of "$1")
    for i in "${!list[@]}"; do
        [[ ${list[$i]} == "$current" ]] && { screen_for_tab "${list[$(( (i + $2 + n) % n ))]}" "$1"; return; }
    done
    echo pacman:all
}

mode_toggle() {
    local src; src=$(source_of "$1")
    [[ -n $src && $1 != *:missing ]] || return
    case $(mode_of "$1") in
        all) echo "$src:installed" ;;
        *) echo "$src:all" ;;
    esac
}

mode_updates() {
    local src; src=$(source_of "$1")
    [[ -n $src && $1 != *:missing ]] || return
    if [[ $(mode_of "$1") == updates ]]; then
        echo "$src:$(cat "$STATE/before-updates" 2>/dev/null || echo all)"
    else
        mode_of "$1" > "$STATE/before-updates"
        echo "$src:updates"
    fi
}

screen_by_label() {
    local t
    while read -r t; do
        [[ $(tab_label "$t") == "$1" ]] && { screen_for_tab "$t" "$2"; return; }
    done < <(tabs)
}

prompt_for() {
    case $1 in
        *:all) echo "󰍉  " ;;
        *:installed) echo "󰏗 instalados  " ;;
        *:updates) echo "󰚰 atualizações  " ;;
        help|*:missing) echo "" ;;
    esac
}

ghost_for() {
    echo "Digite aqui"
}

empty_message() {
    case $1 in
        aur:all) echo "Não foi possível listar o AUR (sem internet?)." ;;
        flatpak:all) echo "Não foi possível listar o Flathub (sem internet?)." ;;
        *:updates) echo "Tudo atualizado." ;;
        pacman:installed|aur:installed) echo "Nenhum pacote seu aqui." ;;
        flatpak:installed) echo "Nenhum app Flatpak instalado." ;;
        *) echo "Nada aqui." ;;
    esac
}

help_lines() {
    local from; from=$(origin)
    local n; n=$(tabs | wc -l)
    local names; names=$(tabs | while read -r t; do tab_label "$t"; done | paste -sd'·' | sed 's/·/ · /g')
    local general=(
        "Alt+1 … Alt+$n|$names"
        "← / →|aba anterior / próxima"
        "Ctrl+S|todos / só os instalados"
        "Ctrl+U|atualizações (de novo: volta)"
        "↑ / ↓|pacote anterior / próximo"
        "Alt+H/J/K/L|o mesmo, no estilo vim"
        "Tab|seleciona vários"
        "Esc|sai"
    )
    local here=() title
    case $from in
        pacman:*|aur:*|flatpak:*) title=$(tab_label "$(source_of "$from")") ;;
    esac
    case $from in
        *:updates) title+=" › Atualizações" ;;
        *:installed) title+=" › Instalados" ;;
    esac
    [[ $from == *:missing ]] && here=("—|instale pelos comandos da tela")
    case $from in
        pacman:all|pacman:installed|aur:all|aur:installed)
            here=("Enter|instala" "Ctrl+R|remove" "Ctrl+L|limpa os órfãos") ;;
        flatpak:all|flatpak:installed)
            here=("Enter|instala" "Ctrl+R|remove" "Ctrl+L|limpa os runtimes sem uso") ;;
        pacman:updates)
            here=("Enter|atualiza todos os pacotes oficiais") ;;
        aur:updates)
            here=("Enter|atualiza os do AUR (com os oficiais em dia)") ;;
        flatpak:updates)
            here=("Enter|atualiza os apps e runtimes do Flatpak") ;;
    esac

    # a mesma largura nas duas tabelas, para alinharem
    local kw=0 dw=0 row k d
    for row in "${general[@]}" "${here[@]}"; do
        k=${row%%|*} d=${row#*|}
        (( ${#k} > kw )) && kw=${#k}
        (( ${#d} > dw )) && dw=${#d}
    done

    local rows cols
    read -r rows cols < <(stty size 2>/dev/null </dev/tty || echo "40 120")
    local height=$(( ${#general[@]} + ${#here[@]} + 8 ))
    local top=$(( (rows - height) / 2 - 3 )) left=$(( (cols - kw - dw - 7) / 2 - 2 ))
    (( top < 0 )) && top=0
    (( left < 0 )) && left=0
    local pad; pad=$(printf '%*s' "$left" '')

    local line_k line_d
    line_k=$(printf '─%.0s' $(seq $((kw + 2))))
    line_d=$(printf '─%.0s' $(seq $((dw + 2))))

    table() {   # título, linhas "atalho|ação"
        local name=$1; shift
        printf '%s%s%s%s\n' "$pad" "$C_BOLD$C_ACCENT" "$name" "$C_RESET"
        printf '%s%s╭%s┬%s╮%s\n' "$pad" "$C_DIM" "$line_k" "$line_d" "$C_RESET"
        local r
        for r in "$@"; do
            k=${r%%|*} d=${r#*|}
            # preenche contando caracteres (o printf conta bytes e desalinha acentos)
            printf '%s%s│%s %s%s%*s%s %s│%s %s%*s %s│%s\n' "$pad" \
                "$C_DIM" "$C_RESET" "$C_ACCENT" "$k" $((kw - ${#k})) "" "$C_RESET" \
                "$C_DIM" "$C_RESET" "$d" $((dw - ${#d})) "" "$C_DIM" "$C_RESET"
        done
        printf '%s%s╰%s┴%s╯%s\n' "$pad" "$C_DIM" "$line_k" "$line_d" "$C_RESET"
    }

    local i
    for (( i = 0; i < top; i++ )); do printf '\n'; done
    table "Geral" "${general[@]}"; printf '\n'
    table "$title" "${here[@]}"; printf '\n'
    printf '%s%sEsc volta%s\n' "$pad" "$C_DIM" "$C_RESET"
}

# Trocar de aba não fecha o fzf: ele chama "--tab"/"--mode"/"--key" e aplica as
# ações impressas. Assim não há intervalo em que uma tecla apertada rápido
# (Alt+L chega como Esc + "l") vire um Esc de verdade.

# A ajuda aparece na hora. As outras carregam em duas etapas: primeiro uma
# linha "carregando…" (assim a tela anterior some na hora) e, quando ela
# termina de entrar, o evento load (on_load) pede a lista de verdade e só então
# volta a prévia e a busca.
show_actions() {
    local target=$1
    set_screen "$target"

    local header
    if [[ $target == help ]]; then header=$(tabs_header "$(origin)"); else header=$(tabs_header "$target"); fi
    printf 'change-header(%s)+change-prompt(%s)+change-ghost(%s)' \
        "$header" "$(prompt_for "$target")" "$(ghost_for "$target")"
    printf '+change-preview-window(%s)' "$PREVIEW_NORMAL"
    if is_text "$target"; then
        rm -f "$STATE/pending"
        touch "$STATE/text"
        printf '+disable-search+clear-query+hide-input+hide-preview+change-pointer( )+reload(%s --list)+first' "$SELF"
    else
        rm -f "$STATE/text"
        touch "$STATE/pending" "$STATE/clear"
        printf '+enable-search+clear-query+hide-input+hide-preview+change-pointer( )+reload(%s --loading)' "$SELF"
    fi
}

on_load() {
    if [[ -f $STATE/pending ]]; then
        rm -f "$STATE/pending"
        printf 'reload(%s --list)' "$SELF"
    elif ! is_text "$(screen)"; then
        printf 'show-input+show-preview+change-pointer(▌)+first'
        # o show-input devolve a busca de antes do hide-input: a busca só
        # fica limpa se o clear-query vier depois dele
        if [[ -f $STATE/clear ]]; then
            rm -f "$STATE/clear"
            printf '+clear-query'
        fi
    fi
}

nav_base() {
    local scr; scr=$(screen)
    [[ $scr == help ]] && scr=$(origin)
    echo "$scr"
}

tab_cmd() {
    local base target
    base=$(nav_base)
    case $1 in
        prev) target=$(tab_step "$base" -1) ;;
        next) target=$(tab_step "$base" 1) ;;
        index:*) target=$(tabs | sed -n "${1#index:}p") && [[ -n $target ]] && target=$(screen_for_tab "$target" "$base") ;;
        label:*) target=$(screen_by_label "${1#label:}" "$base") ;;
    esac
    [[ -n $target ]] && show_actions "$target"
}

mode_cmd() {
    local target
    case $1 in
        toggle) target=$(mode_toggle "$(nav_base)") ;;
        updates) target=$(mode_updates "$(nav_base)") ;;
    esac
    [[ -n $target ]] && show_actions "$target"
}

action_valid() {
    case "$1:$2" in
        pacman:all:*|pacman:installed:*|aur:all:*|aur:installed:*)
            case $2 in enter|ctrl-r|ctrl-l) return 0 ;; esac ;;
        flatpak:all:*|flatpak:installed:*)
            case $2 in enter|ctrl-r|ctrl-l) return 0 ;; esac ;;
        *:updates:enter) return 0 ;;
    esac
    return 1
}

accept_with() {
    printf 'execute-silent(echo %s > %s/key)+accept' "$1" "$STATE"
}

key_cmd() {
    local key=$1; shift
    local scr; scr=$(screen)
    case $key in
        esc)
            [[ $scr == help ]] && show_actions "$(origin)" || printf 'abort' ;;
        ctrl-h)
            if [[ $scr == help ]]; then
                show_actions "$(origin)"
            else
                echo "$scr" > "$STATE/prev"
                show_actions help
            fi ;;
        *)
            action_valid "$scr" "$key" && accept_with "$key" ;;
    esac
}

# Um pacote só, já instalado, abre Instalados filtrado nele (devolve 1 para
# voltar direto à lista, sem o pause)
search_enter() {
    local src=$1; shift
    if (( $# == 1 )) && pacman -Qq "$1" >/dev/null 2>&1; then
        set_screen "$src:installed"
        printf '%s' "$1" > "$STATE/query"
        return 1
    fi
    local missing
    mapfile -t missing < <(pkgs_missing "$@")
    if (( ${#missing[@]} == 0 )); then
        ok "Já estão todos instalados: ${*}"
        return 0
    fi
    title "Instalando: ${missing[*]}"
    if [[ $src == aur ]]; then
        yay -S --needed "${missing[@]}"
    else
        sudo pacman -S --needed "${missing[@]}"
    fi
}

only_installed() {
    local -A missing
    local p
    while read -r p; do missing[$p]=1; done < <(pkgs_missing "$@")
    for p in "$@"; do
        if [[ -z ${missing[$p]:-} ]]; then echo "$p"; else info "\"$p\" não está instalado." >&2; fi
    done
}

# notícias do Arch publicadas depois da última atualização completa
arch_news() {
    local last
    last=$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -1 | grep -oE '^\[[^]]+\]' | tr -d '[]')
    curl -fsS --max-time 8 https://archlinux.org/feeds/news/ 2>/dev/null |
        LAST="$last" node -e '
            let xml = "";
            process.stdin.on("data", d => xml += d).on("end", () => {
                const since = process.env.LAST ? new Date(process.env.LAST) : new Date(0);
                for (const item of xml.split("<item>").slice(1)) {
                    const get = tag => (item.match(new RegExp("<" + tag + ">([\\s\\S]*?)</" + tag + ">")) || [])[1] || "";
                    const date = new Date(get("pubDate"));
                    if (date > since)
                        console.log(date.toLocaleDateString("pt-BR") + "  " + get("title") + "\n            " + get("link"));
                }
            });'
}

update_system() {
    if [[ ! -s $STATE/updates ]]; then
        ok "Os pacotes oficiais estão em dia."
        return
    fi

    title "Notícias do Arch desde a última atualização"
    local news
    news=$(arch_news)
    if [[ -n $news ]]; then
        warn "$news"
        printf '\n'
        info "Algumas notícias pedem um passo manual antes ou depois de atualizar."
        confirm "Continuar com a atualização?" || return
    else
        info "Nenhuma notícia nova."
    fi

    title "Atualizando os pacotes oficiais"
    sudo pacman -Syu || return

    title "Depois da atualização"
    local nothing=1
    if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
        warn "O kernel foi atualizado: reinicie para usar o novo."
        nothing=0
    fi
    local pacnew
    pacnew=$(pacdiff -o 2>/dev/null)
    if [[ -n $pacnew ]]; then
        warn "Configurações novas para revisar (.pacnew):"
        printf '  %s\n' $pacnew
        info "  Para comparar e mesclar: sudo DIFFPROG='nvim -d' pacdiff"
        nothing=0
    fi
    local orphans
    orphans=$(pacman -Qdtq | wc -l)
    if (( orphans > 0 )); then
        warn "$orphans pacote(s) sobrando: veja em Instalados (Ctrl+L limpa)."
        nothing=0
    fi
    if has_yay; then
        info "Os do AUR: aba AUR, em Atualizações."
    fi
    (( nothing )) && ok "Tudo certo."
}

# AUR: só com os oficiais em dia (os pacotes do AUR compilam contra as
# bibliotecas do sistema)
update_aur() {
    if checkupdates >/dev/null 2>&1; then
        warn "Há atualizações oficiais pendentes: atualize antes pela aba Pacman, em Atualizações."
        info "Os pacotes do AUR são compilados contra as bibliotecas do sistema, que precisam estar atualizadas."
        return
    fi
    if [[ ! -s $STATE/updates.aur ]]; then
        ok "Nada para atualizar no AUR."
        return
    fi
    title "Atualizando os pacotes do AUR"
    info "O yay mostra o que mudou em cada PKGBUILD antes de compilar."
    yay -Sua
}

# devolve 1 como o search_enter
flatpak_enter() {
    if (( $# == 1 )) && flatpak info --user "$1" >/dev/null 2>&1; then
        set_screen flatpak:installed
        printf '%s' "$1" > "$STATE/query"
        return 1
    fi
    local missing=() app
    for app in "$@"; do
        flatpak info --user "$app" >/dev/null 2>&1 || missing+=("$app")
    done
    if (( ${#missing[@]} == 0 )); then
        ok "Já estão todos instalados: ${*}"
        return 0
    fi
    title "Instalando do Flathub: ${missing[*]}"
    flatpak install --user flathub "${missing[@]}"
}

handle() {
    local key=$1; shift
    local items=("$@")
    local scr; scr=$(screen)

    case "$scr:$key" in
        pacman:all:enter|pacman:installed:enter|aur:all:enter|aur:installed:enter)
            (( ${#items[@]} )) || return 1
            search_enter "$(source_of "$scr")" "${items[@]}" || return 1 ;;
        pacman:*:ctrl-r|aur:*:ctrl-r)
            local installed
            mapfile -t installed < <(only_installed "${items[@]}")
            (( ${#installed[@]} )) && remove_packages "${installed[@]}" ;;
        pacman:*:ctrl-l|aur:*:ctrl-l) clean_orphans ;;
        pacman:updates:enter) update_system ;;
        aur:updates:enter) update_aur ;;
        flatpak:all:enter|flatpak:installed:enter)
            (( ${#items[@]} )) || return 1
            flatpak_enter "${items[@]}" || return 1 ;;
        flatpak:*:ctrl-r)
            local installed=() app
            for app in "${items[@]}"; do flatpak info --user "$app" >/dev/null 2>&1 && installed+=("$app"); done
            (( ${#installed[@]} )) || { info "Nenhum deles está instalado."; return 0; }
            title "Removendo: ${installed[*]}"
            flatpak uninstall --user "${installed[@]}" ;;
        flatpak:*:ctrl-l)
            title "Removendo os runtimes que nenhum app usa"
            flatpak uninstall --user --unused ;;
        flatpak:updates:enter)
            title "Atualizando os apps e runtimes do Flatpak"
            flatpak update --user ;;
        *) return 1 ;;
    esac
    return 0
}

main() {
    require fzf:fzf checkupdates:pacman-contrib pacdiff:pacman-contrib node:nodejs curl:curl

    STATE=$(mktemp -d -t repostore.XXXXXX)
    export HYPRCONF_PKG_STATE=$STATE
    # limpa também quando a janela é fechada (sinal), não só na saída normal
    trap 'rm -rf "$STATE"' EXIT
    trap 'exit 1' INT TERM HUP
    set_screen pacman:all
    fetch_aur &
    fetch_flatpak &

    local opts
    mapfile -t opts < <(fzf_base_opts)

    local nav=(
        --bind="left:transform:$SELF --tab prev"
        --bind="right:transform:$SELF --tab next"
        --bind="alt-h:transform:$SELF --tab prev"
        --bind="alt-l:transform:$SELF --tab next"
        --bind="ctrl-s:transform:$SELF --mode toggle"
        --bind="ctrl-u:transform:$SELF --mode updates"
        --bind="click-header:transform:$SELF --tab \"label:\$FZF_CLICK_HEADER_WORD\""
        # nas telas de texto as setas rolam; sem chamar o script a cada tecla
        --bind="up:transform:[ -f '$STATE/text' ] && echo offset-up || echo up"
        --bind="down:transform:[ -f '$STATE/text' ] && echo offset-down || echo down"
        --bind="alt-k:transform:[ -f '$STATE/text' ] && echo offset-up || echo up"
        --bind="alt-j:transform:[ -f '$STATE/text' ] && echo offset-down || echo down"
        --bind="esc:transform:$SELF --key esc"
        --bind="ctrl-h:transform:$SELF --key ctrl-h"
        --bind="enter:transform:$SELF --key enter {1}"
        --bind="load:transform:$SELF --on-load"
    )
    local k
    for k in 1 2 3; do
        nav+=(--bind="alt-$k:transform:$SELF --tab index:$k")
    done
    for k in ctrl-r ctrl-l; do
        nav+=(--bind="$k:transform:$SELF --key $k")
    done

    while true; do
        local scr; scr=$(screen)
        local query=""
        if [[ -f $STATE/query ]]; then
            query=$(cat "$STATE/query")
            rm -f "$STATE/query"
        fi
        rm -f "$STATE/key"

        local out
        out=$("$SELF" --list | fzf "${opts[@]}" --multi \
            --prompt="$(prompt_for "$scr")" \
            --header="$(tabs_header "$scr")" --header-first \
            --ghost="$(ghost_for "$scr")" \
            --query="$query" \
            --preview="$SELF --preview {1}" \
            "${nav[@]}") || break

        [[ -f $STATE/key ]] || continue
        local key items
        key=$(cat "$STATE/key")
        mapfile -t items < <(awk 'NF && $1 != "—" { print $1 }' <<< "$out")

        clear
        handle "$key" "${items[@]}" || { clear; continue; }
        pause || break
    done
}

case "${1:-}" in
    --list) list ;;
    --preview) preview "$2" ;;
    --tab) tab_cmd "$2" ;;
    --mode) mode_cmd "$2" ;;
    --on-load) on_load ;;
    --loading) printf '%s— carregando…%s\n' "$C_DIM" "$C_RESET" ;;
    --key) shift; key_cmd "$@" ;;
    *) main ;;
esac
