#!/usr/bin/env bash
# RepoStore: instalar, remover e atualizar pacotes (repositórios oficiais,
# AUR e Flatpak) e organizar em grupos.
#
# Abas (Alt+1…4, ←/→ ou clique trocam; Ctrl+H mostra os atalhos da tela):
#   Pacman    pacotes dos repositórios oficiais
#   AUR       pacotes do AUR, pelo yay (só aparece com o yay instalado)
#   Flatpak   apps do Flathub, só para o seu usuário (só aparece com o flatpak)
#   Grupos    os seus metapacotes e o do hyprconf; Enter entra num grupo
#
# Pacman, AUR e Flatpak mostram tudo (✓ = instalado) ou, com Ctrl+S, só os
# seus instalados (avulsos, em grupos e sobrando); as teclas são as mesmas
# nos dois. Ctrl+U mostra as atualizações daquela fonte (Enter atualiza tudo)
# e, apertado de novo, volta.
#
# Os pacotes do hyprconf não aparecem em Instalados: eles são gerenciados
# pelo PKGBUILD do metapacote (packages/hyprconf-deps; veja em Grupos).
#
# Subcomandos internos (usados pelo fzf): --list, --preview, --tab, --mode, --key,
# --on-load e --loading

set -uo pipefail

SELF=$(readlink -f "$0")
source "$(dirname "$SELF")/lib/common.sh"

STATE=${HYPRCONF_PKG_STATE:-}
PREVIEW_NORMAL='right,45%,border-left,wrap'
FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"

# Telas: "<fonte>:<modo>" (pacman:all, aur:installed, flatpak:updates...),
# "groups", "group:<nome>" e "help".
screen() { cat "$STATE/screen" 2>/dev/null || echo pacman:all; }
set_screen() { echo "$1" > "$STATE/screen"; }

# tela de onde a Ajuda foi aberta
origin() { cat "$STATE/prev" 2>/dev/null || echo pacman:all; }

has_yay() { command -v yay >/dev/null; }
has_flatpak() { command -v flatpak >/dev/null; }

# fonte e modo de uma tela de fonte ("" se não for uma)
source_of() { case $1 in pacman:*|aur:*|flatpak:*) echo "${1%%:*}" ;; esac; }
mode_of() { case $1 in pacman:*|aur:*|flatpak:*) echo "${1#*:}" ;; esac; }

# ---- listas: Pacman --------------------------------------------------------------

list_pacman() {
    LC_ALL=C pacman -Sl | awk -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '{
        mark = ($4 ~ /installed/) ? ok "✓" reset : " "
        printf "%-30s %s %s%-16s %s%s\n", $2, mark, dim, $3, $1, reset
    }'
}

# checkupdates usa uma cópia do banco de dados: não mexe no sistema
list_pacman_updates() {
    checkupdates 2>/dev/null > "$STATE/updates"
    format_updates "$STATE/updates"
}

format_updates() {
    awk -v dim="$C_DIM" -v ok="$C_OK" -v reset="$C_RESET" 'NF >= 4 {
        printf "%-30s %s%-16s%s → %s%s%s\n", $1, dim, $2, reset, ok, $4, reset
    }' "$1"
}

# ---- listas: AUR -----------------------------------------------------------------

# A lista completa demora uns segundos: é baixada em segundo plano assim que o
# app abre e fica guardada durante a sessão.
fetch_aur() {
    has_yay || return 0
    local tmp; tmp=$(mktemp "$STATE/aur.XXXXXX")
    LC_ALL=C yay -Sl aur 2>/dev/null | awk '{ print $2 }' > "$tmp" && mv -f "$tmp" "$STATE/aur.list"
}

list_aur() {
    [[ -s $STATE/aur.list ]] || fetch_aur
    # marca os instalados (pacman -Qm: os de fora dos repositórios oficiais)
    # (FILENAME, e não NR == FNR: com a lista de instalados vazia, o NR == FNR
    # valeria também para a segunda lista)
    awk -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '
        FILENAME == ARGV[1] { installed[$1] = $2; next }
        ($1 in installed) { printf "%-30s %s✓%s %s%s%s\n", $1, ok, reset, dim, installed[$1], reset; next }
        { print }' <(pacman -Qm) "$STATE/aur.list"
}

# consulta o AUR pela internet
list_aur_updates() {
    LC_ALL=C yay -Qua 2>/dev/null > "$STATE/updates.aur"
    format_updates "$STATE/updates.aur"
}

# ---- listas: Flatpak -------------------------------------------------------------
# Tudo só para o seu usuário (--user): sem senha.

# O Flathub no modo usuário e o tema do hyprconf nos apps (uma vez; repetir não
# muda nada). Os apps libadwaita leem as cores pelo ~/.config/gtk-4.0/gtk.css,
# que importa o colors.css do tema: os dois ficam visíveis, só para leitura. A
# pasta inteira do tema não: o gtk.css do GTK3 importa o adw-gtk3 de
# /usr/share/themes, que não existe dentro do Flatpak (o app acharia o tema e
# abriria sem estilo). Os apps GTK3 ficam com o Adwaita escuro.
flatpak_setup() {
    flatpak remote-add --user --if-not-exists flathub "$FLATHUB_URL" &&
        flatpak override --user \
            --filesystem=xdg-config/gtk-4.0:ro \
            --filesystem=xdg-data/themes/Hyprconf/colors.css:ro
}

fetch_flatpak() {
    has_flatpak || return 0
    flatpak_setup >/dev/null 2>&1
    local tmp; tmp=$(mktemp "$STATE/flatpak.XXXXXX")
    flatpak remote-ls --user flathub --app --columns=application,name,version 2>/dev/null > "$tmp" &&
        mv -f "$tmp" "$STATE/flatpak.list"
}

list_flatpak() {
    [[ -s $STATE/flatpak.list ]] || fetch_flatpak
    awk -F'\t' -v ok="$C_OK" -v dim="$C_DIM" -v reset="$C_RESET" '
        FILENAME == ARGV[1] { installed[$1] = 1; next }
        { printf "%-42s %s %s%s  %s%s\n", $1, (($1 in installed) ? ok "✓" reset : " "), "", $2, dim $3, reset }
    ' <(flatpak list --user --app --columns=application 2>/dev/null) "$STATE/flatpak.list"
}

list_flatpak_installed() {
    flatpak list --user --app --columns=application,name,version 2>/dev/null |
        awk -F'\t' -v dim="$C_DIM" -v reset="$C_RESET" '{ printf "%-42s %s  %s%s%s\n", $1, $2, dim, $3, reset }'
}

list_flatpak_updates() {
    flatpak remote-ls --user --updates --app --columns=application,name,version 2>/dev/null |
        awk -F'\t' -v ok="$C_OK" -v reset="$C_RESET" '{ printf "%-42s %s  → %s%s%s\n", $1, $2, ok, $3, reset }'
}

# ---- listas: Grupos --------------------------------------------------------------

list_groups() {
    local g n missing status
    # o metapacote do hyprconf vem primeiro e só se vê (muda pelo PKGBUILD)
    { [[ -f $SETUP_PKGBUILD ]] && echo "$SETUP_META"; groups_list; } | while read -r g; do
        n=$(group_packages "$g" | wc -l)
        missing=$(group_missing "$g" | wc -l)
        status=""
        if ! group_meta_installed "$g"; then
            status="${C_WARN}não aplicado${C_RESET}"
        elif (( missing > 0 )); then
            status="${C_WARN}falta instalar $missing${C_RESET}"
        fi
        [[ $g == "$SETUP_META" ]] && status="${C_ACCENT}[hyprconf]${C_RESET} $status"
        printf '%-24s %s%d pacote(s)%s  %s\n' "$g" "$C_DIM" "$n" "$C_RESET" "$status"
    done
}

# Uma linha por pacote dado, na ordem: a versão ou a descrição dele, ou vazia
# se não estiver instalado. Uma chamada só ao pacman; as linhas casam pela
# posição, porque um nome que um pacote provê sai com o nome do pacote
# (ex.: "sh" -> bash).
pkgs_field() {   # version | description, pacotes...
    local field=$1; shift
    local -A missing
    local p installed=() values=() i=0
    while read -r p; do missing[$p]=1; done < <(pkgs_missing "$@")
    for p in "$@"; do [[ -n ${missing[$p]:-} ]] || installed+=("$p"); done
    if (( ${#installed[@]} )); then
        if [[ $field == version ]]; then
            mapfile -t values < <(pacman -Q "${installed[@]}" 2>/dev/null | cut -d' ' -f2)
        else
            mapfile -t values < <(pacman -Qi "${installed[@]}" 2>/dev/null |
                awk -F': ' '/^(Descrição|Description)/ { print $2 }')
        fi
    fi
    for p in "$@"; do
        if [[ -n ${missing[$p]:-} ]]; then echo; else printf '%s\n' "${values[i++]:-}"; fi
    done
}

list_group() {
    local pkgs versions i
    mapfile -t pkgs < <(group_packages "$1")
    mapfile -t versions < <(pkgs_field version "${pkgs[@]}")
    for i in "${!pkgs[@]}"; do
        if [[ -n ${versions[i]:-} ]]; then
            printf '%-30s %s%s%s\n' "${pkgs[i]}" "$C_DIM" "${versions[i]}" "$C_RESET"
        else
            printf '%-30s %s[falta instalar]%s\n' "${pkgs[i]}" "$C_WARN" "$C_RESET"
        fi
    done
}

list() {
    local scr out
    scr=$(screen)
    case $scr in
        pacman:all) out=$(list_pacman) ;;
        pacman:installed) out=$(list_installed repo) ;;
        pacman:updates) out=$(list_pacman_updates) ;;
        aur:all) out=$(list_aur) ;;
        aur:installed) out=$(list_installed aur) ;;
        aur:updates) out=$(list_aur_updates) ;;
        flatpak:all) out=$(list_flatpak) ;;
        flatpak:installed) out=$(list_flatpak_installed) ;;
        flatpak:updates) out=$(list_flatpak_updates) ;;
        groups) out=$(list_groups) ;;
        group:*) out=$(list_group "${scr#group:}") ;;
        help) help_lines; return ;;
    esac
    # lista vazia: uma linha explicando (as ações ignoram essa linha)
    if [[ -n $out ]]; then
        printf '%s\n' "$out"
    else
        printf '%s— %s%s\n' "$C_DIM" "$(empty_message "$scr")" "$C_RESET"
    fi
}

# ---- prévia ---------------------------------------------------------------------

# pacote do pacman ou do AUR: o que ele é, se está instalado e em que grupo
preview_package() {
    local item=$1 src=$2
    if pacman -Qq "$item" >/dev/null 2>&1; then
        preview_installed "$item"
        return
    fi
    if [[ $src == aur ]]; then
        printf '%sAUR: pacote enviado pela comunidade. O yay mostra o PKGBUILD para revisar antes de instalar.%s\n\n' "$C_WARN" "$C_RESET"
        yay -Si --aur "$item" 2>/dev/null | paint
    else
        pacman -Si "$item" 2>/dev/null | paint
    fi
    local g; g=$(group_of "$item")
    [[ -n $g ]] && printf '\n%sno grupo "%s" (ainda não instalado)%s\n' "$C_MAGENTA" "$g" "$C_RESET"
}

preview_update() {
    local item=$1 file=$2 line
    line=$(grep -h -m1 "^$item " "$file" 2>/dev/null)
    [[ -n $line ]] && printf '%s%s%s  %s → %s%s%s\n\n' "$C_BOLD" "$item" "$C_RESET" \
        "$(cut -d' ' -f2 <<< "$line")" "$C_OK" "$(cut -d' ' -f4 <<< "$line")" "$C_RESET"
}

preview() {
    local item=$1
    [[ $item == "—" ]] && return
    case $(screen) in
        pacman:all|pacman:installed) preview_package "$item" pacman ;;
        aur:all|aur:installed) preview_package "$item" aur ;;
        pacman:updates)
            preview_update "$item" "$STATE/updates"
            pacman -Si "$item" 2>/dev/null | paint ;;
        aur:updates)
            preview_update "$item" "$STATE/updates.aur"
            yay -Si --aur "$item" 2>/dev/null | paint ;;
        flatpak:*)
            local details
            if details=$(flatpak info --user "$item" 2>/dev/null); then
                printf '%s✓ instalado%s\n\n' "$C_OK" "$C_RESET"
                printf '%s\n' "$details" | paint
            else
                flatpak remote-info --user flathub "$item" 2>/dev/null | paint
            fi ;;
        group:*)
            if pacman -Qq "$item" >/dev/null 2>&1; then
                preview_installed "$item"
            else
                printf '%sAinda não instalado: Alt+Enter instala o que falta no grupo.%s\n\n' "$C_WARN" "$C_RESET"
                pacman -Si "$item" 2>/dev/null | paint || yay -Si --aur "$item" 2>/dev/null | paint
            fi ;;
        groups)
            if [[ $item == "$SETUP_META" ]]; then
                printf '%sO metapacote do hyprconf%s  %s(%s)%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$SETUP_PKGBUILD" "$C_RESET"
                printf '%sTudo o que o setup precisa. Só para ver: muda pelo PKGBUILD e o install.sh.%s\n\n' "$C_DIM" "$C_RESET"
            else
                printf '%sGrupo "%s"%s  %s(%s)%s\n\n' "$C_BOLD" "$item" "$C_RESET" "$C_DIM" "$GROUPS_DIR/$item" "$C_RESET"
            fi
            local pkgs descs desc i
            mapfile -t pkgs < <(group_packages "$item")
            mapfile -t descs < <(pkgs_field description "${pkgs[@]}")
            for i in "${!pkgs[@]}"; do
                desc=${descs[i]:-}
                [[ -z $desc ]] && desc="${C_WARN}(falta instalar)${C_RESET}"
                printf '  %-30s %s\n' "${pkgs[i]}" "$desc"
            done ;;
    esac
}

# ---- abas e modos ----------------------------------------------------------------

# abas, na ordem (AUR e Flatpak só com o yay e o flatpak instalados)
tabs() {
    echo pacman
    has_yay && echo aur
    has_flatpak && echo flatpak
    echo groups
}

tab_of() {
    case $1 in
        group:*|groups) echo groups ;;
        *) source_of "$1" ;;
    esac
}

tab_label() {
    case $1 in
        pacman) echo "Pacman" ;;
        aur) echo "AUR" ;;
        flatpak) echo "Flatpak" ;;
        groups) echo "Grupos" ;;
    esac
}

# cabeçalho com as abas: a atual sublinhada e na cor de destaque
tabs_header() {
    local current out="" t
    current=$(tab_of "$1")
    while read -r t; do
        if [[ $t == "$current" ]]; then
            out+="${C_BOLD}${C_ACCENT}"$'\e[4m'"$(tab_label "$t")${C_RESET}   "
        else
            out+="${C_DIM}$(tab_label "$t")${C_RESET}   "
        fi
    done < <(tabs)
    printf '%s' "$out"
}

# tela de uma aba, mantendo o modo da tela atual (Instalados no Pacman leva a
# Instalados no AUR)
screen_for_tab() {
    local tab=$1 mode
    [[ $tab == groups ]] && { echo groups; return; }
    mode=$(mode_of "$2")
    echo "$tab:${mode:-all}"
}

# aba vizinha: step = -1 (anterior) ou 1 (próxima), dando a volta
tab_step() {
    local list current i n
    mapfile -t list < <(tabs)
    n=${#list[@]}
    current=$(tab_of "$1")
    for i in "${!list[@]}"; do
        [[ ${list[$i]} == "$current" ]] && { screen_for_tab "${list[$(( (i + $2 + n) % n ))]}" "$1"; return; }
    done
    echo pacman:all
}

# Ctrl+S: Todos <-> Instalados (das Atualizações, vai para Todos)
mode_toggle() {
    local src; src=$(source_of "$1")
    [[ -n $src ]] || return
    case $(mode_of "$1") in
        all) echo "$src:installed" ;;
        *) echo "$src:all" ;;
    esac
}

# Ctrl+U: para as Atualizações; nelas, volta para onde estava
mode_updates() {
    local src; src=$(source_of "$1")
    [[ -n $src ]] || return
    if [[ $(mode_of "$1") == updates ]]; then
        echo "$src:$(cat "$STATE/before-updates" 2>/dev/null || echo all)"
    else
        mode_of "$1" > "$STATE/before-updates"
        echo "$src:updates"
    fi
}

# aba pelo nome clicado
screen_by_label() {
    local t
    while read -r t; do
        [[ $(tab_label "$t") == "$1" ]] && { screen_for_tab "$t" "$2"; return; }
    done < <(tabs)
}

prompt_for() {
    case $1 in
        *:all) echo "󰍉  " ;;
        *:installed) echo "󰏗 instalados  " ;;
        *:updates) echo "󰚰 atualizações  " ;;
        groups) echo "󰉋  " ;;
        group:*) echo "󰉋 ${1#group:}  " ;;
        help) echo "" ;;
    esac
}

ghost_for() {
    echo "Digite aqui"
}

empty_message() {
    case $1 in
        groups) echo "Nenhum grupo ainda: em Pacman ou AUR, Alt+Enter instala num grupo novo." ;;
        aur:all) echo "Não foi possível listar o AUR (sem internet?)." ;;
        flatpak:all) echo "Não foi possível listar o Flathub (sem internet?)." ;;
        *:updates) echo "Tudo atualizado." ;;
        pacman:installed|aur:installed) echo "Nenhum pacote seu aqui (além dos do hyprconf)." ;;
        flatpak:installed) echo "Nenhum app Flatpak instalado." ;;
        *) echo "Nada aqui." ;;
    esac
}

# ---- ajuda (Ctrl+H) ---------------------------------------------------------------

# atalhos gerais e os da tela de onde a ajuda foi aberta, em tabelas centralizadas
help_lines() {
    local from; from=$(origin)
    local n; n=$(tabs | wc -l)
    local names; names=$(tabs | while read -r t; do tab_label "$t"; done | paste -sd'·' | sed 's/·/ · /g')
    local general=(
        "Alt+1 … Alt+$n|$names"
        "← / →|aba anterior / próxima"
        "Ctrl+S|todos / só os instalados"
        "Ctrl+U|atualizações (de novo: volta)"
        "↑ / ↓|pacote anterior / próximo"
        "Alt+H/J/K/L|o mesmo, no estilo vim"
        "Tab|seleciona vários"
        "Esc|sai"
    )
    local here=() title
    case $from in
        pacman:*|aur:*|flatpak:*) title=$(tab_label "$(source_of "$from")") ;;
    esac
    case $from in
        *:updates) title+=" › Atualizações" ;;
        *:installed) title+=" › Instalados" ;;
    esac
    case $from in
        pacman:all|pacman:installed|aur:all|aur:installed)
            here=("Enter|instala" "Alt+Enter|instala num grupo" "Ctrl+R|remove"
                  "Ctrl+G|põe num grupo (os não instalados entram sem instalar)"
                  "Ctrl+L|limpa os órfãos") ;;
        flatpak:all|flatpak:installed)
            here=("Enter|instala" "Ctrl+R|remove" "Ctrl+L|limpa os runtimes sem uso") ;;
        pacman:updates)
            here=("Enter|atualiza todos os pacotes oficiais") ;;
        aur:updates)
            here=("Enter|atualiza os do AUR (com os oficiais em dia)") ;;
        flatpak:updates)
            here=("Enter|atualiza os apps e runtimes do Flatpak") ;;
        groups)
            title="Grupos"
            here=("Enter|entra no grupo") ;;
        "group:$SETUP_META")
            title="Metapacote do hyprconf"
            here=("—|só para ver: muda pelo PKGBUILD (packages/hyprconf-deps)") ;;
        group:*)
            title="Grupo \"${from#group:}\""
            here=("Alt+Enter|instala o que falta no grupo"
                  "Ctrl+R|remove o pacote" "Ctrl+G|tira do grupo"
                  "Ctrl+X|desfaz o grupo (os pacotes ficam)" "Ctrl+D|apaga o grupo e os pacotes") ;;
    esac

    # largura das colunas: a maior de todas as linhas (as tabelas alinham)
    local kw=0 dw=0 row k d
    for row in "${general[@]}" "${here[@]}"; do
        k=${row%%|*} d=${row#*|}
        (( ${#k} > kw )) && kw=${#k}
        (( ${#d} > dw )) && dw=${#d}
    done

    local rows cols
    read -r rows cols < <(stty size 2>/dev/null </dev/tty || echo "40 120")
    local height=$(( ${#general[@]} + ${#here[@]} + 8 ))
    local top=$(( (rows - height) / 2 - 3 )) left=$(( (cols - kw - dw - 7) / 2 - 2 ))
    (( top < 0 )) && top=0
    (( left < 0 )) && left=0
    local pad; pad=$(printf '%*s' "$left" '')

    local line_k line_d
    line_k=$(printf '─%.0s' $(seq $((kw + 2))))
    line_d=$(printf '─%.0s' $(seq $((dw + 2))))

    table() {   # título, linhas "atalho|ação"
        local name=$1; shift
        printf '%s%s%s%s\n' "$pad" "$C_BOLD$C_ACCENT" "$name" "$C_RESET"
        printf '%s%s╭%s┬%s╮%s\n' "$pad" "$C_DIM" "$line_k" "$line_d" "$C_RESET"
        local r
        for r in "$@"; do
            k=${r%%|*} d=${r#*|}
            # preenche contando caracteres (o printf conta bytes e desalinha acentos)
            printf '%s%s│%s %s%s%*s%s %s│%s %s%*s %s│%s\n' "$pad" \
                "$C_DIM" "$C_RESET" "$C_ACCENT" "$k" $((kw - ${#k})) "" "$C_RESET" \
                "$C_DIM" "$C_RESET" "$d" $((dw - ${#d})) "" "$C_DIM" "$C_RESET"
        done
        printf '%s%s╰%s┴%s╯%s\n' "$pad" "$C_DIM" "$line_k" "$line_d" "$C_RESET"
    }

    local i
    for (( i = 0; i < top; i++ )); do printf '\n'; done
    table "Geral" "${general[@]}"; printf '\n'
    table "$title" "${here[@]}"; printf '\n'
    printf '%s%sEsc volta%s\n' "$pad" "$C_DIM" "$C_RESET"
}

# ---- navegação dentro do fzf ------------------------------------------------------
# Trocar de aba não fecha o fzf: ele chama "--tab"/"--mode"/"--key" e aplica as
# ações impressas. Assim não há intervalo em que uma tecla apertada rápido
# (Alt+L chega como Esc + "l") vire um Esc de verdade.

# ações do fzf que mostram uma tela (aba, modo, grupo ou ajuda)
#
# A ajuda aparece na hora. As outras carregam em duas etapas: primeiro uma
# linha "carregando…" (assim a tela anterior some na hora) e, quando ela
# termina de entrar, o evento load (on_load) pede a lista de verdade e só então
# volta a prévia e a busca.
show_actions() {
    local target=$1
    set_screen "$target"

    local header
    if [[ $target == help ]]; then header=$(tabs_header "$(origin)"); else header=$(tabs_header "$target"); fi
    printf 'change-header(%s)+change-prompt(%s)+change-ghost(%s)' \
        "$header" "$(prompt_for "$target")" "$(ghost_for "$target")"
    printf '+change-preview-window(%s)' "$PREVIEW_NORMAL"
    if [[ $target == help ]]; then
        rm -f "$STATE/pending"
        # sem busca: o que for digitado não filtra o texto da ajuda
        printf '+disable-search+clear-query+hide-input+hide-preview+change-pointer( )+reload(%s --list)+first' "$SELF"
    else
        touch "$STATE/pending" "$STATE/clear"
        printf '+enable-search+clear-query+hide-input+hide-preview+change-pointer( )+reload(%s --loading)' "$SELF"
    fi
}

# evento load: a linha "carregando…" entrou (pede a lista) ou a lista entrou
# (mostra a prévia e a busca)
on_load() {
    if [[ -f $STATE/pending ]]; then
        rm -f "$STATE/pending"
        printf 'reload(%s --list)' "$SELF"
    elif [[ $(screen) != help ]]; then
        printf 'show-input+show-preview+change-pointer(▌)+first'
        # o show-input devolve a busca de antes do hide-input: a busca só
        # fica limpa se o clear-query vier depois dele
        if [[ -f $STATE/clear ]]; then
            rm -f "$STATE/clear"
            printf '+clear-query'
        fi
    fi
}

# a tela base para navegar: na ajuda, a de onde ela foi aberta
nav_base() {
    local scr; scr=$(screen)
    [[ $scr == help ]] && scr=$(origin)
    echo "$scr"
}

# --tab prev|next|index:<n>|label:<nome>
tab_cmd() {
    local base target
    base=$(nav_base)
    case $1 in
        prev) target=$(tab_step "$base" -1) ;;
        next) target=$(tab_step "$base" 1) ;;
        index:*) target=$(tabs | sed -n "${1#index:}p") && [[ -n $target ]] && target=$(screen_for_tab "$target" "$base") ;;
        label:*) target=$(screen_by_label "${1#label:}" "$base") ;;
    esac
    [[ -n $target ]] && show_actions "$target"
}

# --mode toggle (Ctrl+S) | updates (Ctrl+U)
mode_cmd() {
    local target
    case $1 in
        toggle) target=$(mode_toggle "$(nav_base)") ;;
        updates) target=$(mode_updates "$(nav_base)") ;;
    esac
    [[ -n $target ]] && show_actions "$target"
}

# teclas de ação que valem em cada tela (as outras são ignoradas)
action_valid() {
    case "$1:$2" in
        pacman:all:*|pacman:installed:*|aur:all:*|aur:installed:*)
            case $2 in enter|alt-enter|ctrl-r|ctrl-g|ctrl-l) return 0 ;; esac ;;
        flatpak:all:*|flatpak:installed:*)
            case $2 in enter|ctrl-r|ctrl-l) return 0 ;; esac ;;
        *:updates:enter) return 0 ;;
        "group:$SETUP_META":*) return 1 ;;   # só para ver
        group:*:alt-enter|group:*:ctrl-r|group:*:ctrl-g|group:*:ctrl-x|group:*:ctrl-d) return 0 ;;
    esac
    return 1
}

accept_with() {
    printf 'execute-silent(echo %s > %s/key)+accept' "$1" "$STATE"
}

# --key <tecla> [itens]
key_cmd() {
    local key=$1; shift
    local scr; scr=$(screen)
    case $key in
        up|down)
            # na ajuda as setas rolam o texto
            [[ $scr == help ]] && printf 'offset-%s' "$key" || printf '%s' "$key" ;;
        esc)
            [[ $scr == help ]] && show_actions "$(origin)" || printf 'abort' ;;
        ctrl-h)
            if [[ $scr == help ]]; then
                show_actions "$(origin)"
            else
                echo "$scr" > "$STATE/prev"
                show_actions help
            fi ;;
        enter)
            if [[ $scr == groups ]]; then
                [[ -n ${1:-} && ( -d $GROUPS_DIR/$1 || $1 == "$SETUP_META" ) ]] && show_actions "group:$1"
            else
                action_valid "$scr" enter && accept_with enter
            fi ;;
        *)
            action_valid "$scr" "$key" && accept_with "$key" ;;
    esac
}

