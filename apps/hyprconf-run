#!/usr/bin/env bash
# Abre um programa padrão de ~/hyprconf/defaults.conf, com argumentos.
#   hyprconf-run terminal
#   hyprconf-run editor ~/hyprconf/hypr/config/binds.lua
# Lê o arquivo a cada uso: trocar um padrão vale na hora.

conf="$HOME/hyprconf/defaults.conf"
name=${1:?uso: hyprconf-run <programa> [argumentos]}
shift

cmd=$(awk -F= -v key="$name" '
    /^[[:space:]]*(#|$)/ { next }
    { k = $1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", k) }
    k == key { sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
' "$conf")

if [[ -z $cmd ]]; then
    notify-send "hyprconf" "\"$name\" não está em defaults.conf" 2>/dev/null
    echo "hyprconf-run: \"$name\" não está em $conf" >&2
    exit 1
fi

# o comando pode ter argumentos próprios (ex.: "foot -e nvim")
exec sh -c "$cmd \"\$@\"" hyprconf-run "$@"
