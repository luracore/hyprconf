configuration {
  show-icons: true;
  modi: "dmenu";
  display-dmenu: "";
  kb-row-left: "h";
  kb-row-down: "j";
  kb-row-up: "k";
  kb-row-right: "l";
}

* {
  background: #171717;
  foreground: #e5e5e5;
  selected: #303030;
  active: #444444;
  urgent: #cc6666;
}

window {
  width: 915px;
  padding: 20px;
  border: 1px;
  border-color: #383838;
  border-radius: 12px;
  background-color: @background;
}

mainbox {
  background-color: @background;
  children: [ listview];
}

listview {
  columns: 3;
  lines: 3;
  spacing: 14px;
  fixed-height: false;
  fixed-columns: false;
  layout: vertical;
  flow: horizontal;
  dynamic: true;
  scrollbar: false;

  border: 0px;
  padding: 0px;
}

element {
  orientation: vertical;
  padding: 0px;
  spacing: 0px;
  background-color: @background;
}

element selected {
  background-color: @selected;
  border: 2px;
  border-color: #89b4fa;
}

element-icon {
  size: 280px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}

element-text {
  enabled: false;
}
