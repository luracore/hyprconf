* {
    bg:          #1f1f1f;
    bg-alt:      #181818;
    fg:          #d8d8d8;
    fg-alt:      #9a9a9a;
    accent:      #7aa89f;
    surface:     #2a2a2a;
    border:      #363636;

    font: "JetBrainsMono Nerd Font 16";
}

element-text,
element-icon,
mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    width: 600px;
    height: 380px;

    border: 1px;
    border-color: @border;
    border-radius: 10px;
    background-color: @bg;
}

mainbox {
    padding: 16px;
    background-color: @bg;
    children: [inputbar, listview];
}

inputbar {
    padding: 10px 13px;
    margin: 0px 0px 10px 0px;

    border-radius: 7px;
    background-color: @surface;

    children: [prompt, entry];
}

prompt {
    padding: 0px 8px 0px 0px;

    background-color: transparent;
    text-color: @accent;
}

entry {
    padding: 0px;

    background-color: transparent;
    text-color: @fg;

    placeholder: "Pesquisar...";
    placeholder-color: @fg-alt;
}

listview {
    padding: 0px;
    margin: 0px;

    columns: 1;
    lines: 8;

    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    margin: 2px 0px;

    border-radius: 6px;

    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 26px;
    padding: 0px 11px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: @surface;
    text-color: @fg;
}

element selected element-text {
    text-color: @accent;
}

mode-switcher {
    enabled: false;
}
