* {
    bg:          #1e1e2e;
    bg-alt:      #181825;
    fg:          #cdd6f4;
    fg-alt:      #a6adc8;
    blue:        #89b4fa;
    surface:     #313244;
    overlay:     #6c7086;

    font: "JetBrainsMono Nerd Font 18";
}

element-text,
element-icon,
mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    width: 700px;
    height: 500px;

    border: 0px;
    border-radius: 16px;
    background-color: @bg;
}

mainbox {
    padding: 20px;
    background-color: @bg;
    children: [inputbar, listview];
}

inputbar {
    padding: 12px 16px;
    margin: 0px 0px 15px 0px;

    border-radius: 10px;
    background-color: @surface;

    children: [prompt, entry];
}

prompt {
    padding: 0px 10px 0px 0px;

    background-color: transparent;
    text-color: @blue;
}

entry {
    padding: 0px;

    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @overlay;
}

listview {
    padding: 0px;
    margin: 0px;

    columns: 1;
    lines: 8;

    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    margin: 3px 0px;

    border-radius: 10px;

    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 32px;
    padding: 0px 12px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: @surface;
    text-color: @blue;
}

element selected element-text {
    text-color: @fg;
}

mode-switcher {
    enabled: false;
}
