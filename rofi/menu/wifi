#!/usr/bin/env bash

set -u

# ─────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────

rofi_input() {
    local prompt="$1"
    local message="${2:-}"

    rofi -dmenu -i \
        -p "$prompt" \
        ${message:+-mesg "$message"}
}

notify() {
    notify-send "Wi-Fi" "$1"
}

signal_icon() {
    local signal=$1

    if (( signal >= 80 )); then
        echo "󰤨"
    elif (( signal >= 60 )); then
        echo "󰤥"
    elif (( signal >= 40 )); then
        echo "󰤢"
    else
        echo "󰤟"
    fi
}

# ─────────────────────────────────────────────
# Atualiza redes
# ─────────────────────────────────────────────

nmcli device wifi rescan >/dev/null 2>&1

# Rede atualmente conectada
current=$(
    nmcli -t -f ACTIVE,SSID device wifi |
    awk -F: '$1 == "yes" {print $2; exit}'
)

# Conexões conhecidas
known=$(
    nmcli -t -f NAME connection show
)

# ─────────────────────────────────────────────
# Lista de redes
# ─────────────────────────────────────────────

wifi_list=$(
    nmcli -t -f SSID,SECURITY,SIGNAL device wifi |
    awk -F: '!seen[$1]++ && $1 != ""' |
    while IFS=: read -r ssid security signal; do

        icon=$(signal_icon "$signal")

        if [[ "$ssid" == "$current" ]]; then
            printf '%s  %s  ✓\n' "$icon" "$ssid"

        elif grep -Fxq "$ssid" <<< "$known"; then
            printf '%s  %s  ●\n' "$icon" "$ssid"

        elif [[ -n "$security" ]]; then
            printf '%s  %s  \n' "$icon" "$ssid"

        else
            printf '%s  %s\n' "$icon" "$ssid"
        fi

    done
)

chosen=$(
    printf '%s\n' "$wifi_list" |
    rofi -dmenu -i \
        -p "" \
        -mesg "Wi-Fi"
)

[[ -z "$chosen" ]] && exit 0

# Recupera o SSID
ssid=$(
    printf '%s' "$chosen" |
    sed -E 's/^[^ ]+[[:space:]]+//' |
    sed -E 's/[[:space:]]+(✓|●|)$//'
)

# ─────────────────────────────────────────────
# Rede já conectada
# ─────────────────────────────────────────────

if [[ "$ssid" == "$current" ]]; then
    notify "Já conectado a $ssid"
    exit 0
fi

# ─────────────────────────────────────────────
# Rede conhecida
# ─────────────────────────────────────────────

if grep -Fxq "$ssid" <<< "$known"; then

    if nmcli connection up "$ssid" >/dev/null 2>&1; then
        notify "Conectado a $ssid"
    else
        notify "Não foi possível conectar a $ssid"
    fi

    exit 0
fi

# ─────────────────────────────────────────────
# Configuração da nova conexão
# ─────────────────────────────────────────────

# Tipo de segurança
security=$(
    printf '%s\n' \
        "Open" \
        "WPA-Personal" \
        "WPA-Enterprise" |
    rofi -dmenu -i \
        -p "Security" \
        -mesg "$ssid"
)

[[ -z "$security" ]] && exit 0

# ─────────────────────────────────────────────
# Open
# ─────────────────────────────────────────────

if [[ "$security" == "Open" ]]; then

    if nmcli connection add \
        type wifi \
        con-name "$ssid" \
        ifname "*" \
        ssid "$ssid" >/dev/null 2>&1 &&
       nmcli connection up "$ssid" >/dev/null 2>&1; then

        notify "Conectado a $ssid"
    else
        notify "Não foi possível conectar a $ssid"
    fi

    exit 0
fi

# ─────────────────────────────────────────────
# WPA-Personal
# ─────────────────────────────────────────────

if [[ "$security" == "WPA-Personal" ]]; then

    password=$(
        rofi -dmenu \
            -password \
            -p "" \
            -mesg "$ssid"
    )

    [[ -z "$password" ]] && exit 0

    if nmcli device wifi connect "$ssid" \
        password "$password" >/dev/null 2>&1; then

        notify "Conectado a $ssid"
    else
        notify "Senha incorreta ou não foi possível conectar"
    fi

    exit 0
fi

# ─────────────────────────────────────────────
# WPA-Enterprise
# ─────────────────────────────────────────────

identity=$(
    rofi_input "󰗊" "Identity — deixe vazio se não usar"
)

[[ -z "$identity" ]] && {
    notify "Identidade não informada"
    exit 0
}

password=$(
    rofi -dmenu \
        -password \
        -p "" \
        -mesg "$ssid"
)

[[ -z "$password" ]] && exit 0

# EAP
eap=$(
    printf '%s\n' \
        "PEAP" \
        "TTLS" \
        "TLS" \
        "PWD" \
        "FAST" |
    rofi -dmenu -i \
        -p "EAP" \
        -mesg "$ssid"
)

[[ -z "$eap" ]] && exit 0

# Autenticação interna
phase2=$(
    printf '%s\n' \
        "" \
        "MSCHAPv2" \
        "MSCHAP" \
        "PAP" \
        "GTC" \
        "CHAP" |
    rofi -dmenu -i \
        -p "Phase 2" \
        -mesg "$ssid"
)

# Cria a conexão
if ! nmcli connection add \
    type wifi \
    con-name "$ssid" \
    ifname "*" \
    ssid "$ssid" >/dev/null 2>&1; then

    notify "Não foi possível criar a conexão"
    exit 1
fi

# Configuração básica Enterprise
nmcli connection modify "$ssid" \
    wifi-sec.key-mgmt wpa-eap \
    802-1x.identity "$identity" \
    802-1x.password "$password" \
    802-1x.eap "$eap"

# Phase 2 é opcional
if [[ -n "$phase2" ]]; then
    nmcli connection modify "$ssid" \
        802-1x.phase2-auth "$phase2"
fi

# Tenta conectar
if nmcli connection up "$ssid" >/dev/null 2>&1; then
    notify "Conectado a $ssid"
else
    notify "Não foi possível conectar a $ssid"
fi
